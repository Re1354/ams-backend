# ==========================================================================
#  AMS-DIU Backend — environment configuration
#  Copy this file to ".env" on the VPS and fill in real values:
#      cp .env.example .env && nano .env
#  The .env file is git-ignored, so it survives every deploy.
# ==========================================================================

# --- Django ---------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Set True only if you must accept any frontend origin. Leave False for prod.
CORS_ALLOW_ALL_ORIGINS=False

# --- Database (PostgreSQL, persistent) ------------------------------------
# These three are used both to create the postgres container AND to build the
# DATABASE_URL the Django container connects with. Use only URL-safe chars
# (letters/digits) in the password to avoid escaping issues.
DB_NAME=amsdiudb
DB_USER=amsadmin
DB_PASSWORD=ChangeThisStrongPassword123

# --- Domains & SSL --------------------------------------------------------
API_DOMAIN=api.tatomal.me
# Email used by Let's Encrypt for certificate expiry notices.
LETSENCRYPT_EMAIL=admin@tatomal.me
